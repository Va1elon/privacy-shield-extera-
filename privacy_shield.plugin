# -*- coding: utf-8 -*-
"""Privacy Shield for exteraGram / AyuGram Android.

Local-only safety guard. It does not promise anonymity and does not alter
Telegram server-side privacy/account settings.
"""

import ipaddress
import re
import time
from typing import Any, List, Optional
from urllib.parse import parse_qsl, urlsplit

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.bulletin import BulletinHelper
from ui.settings import Header, Switch, Text

__id__ = "privacy_shield"
__name__ = "Privacy Shield | Anti-Dox"
__description__ = "Локальные блокировки опасных отправок, геоданных и контактов; предупреждения о фишинге и угрозах."
__author__ = "va1elon"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["privacy", "tools"]

# No remote lists, libraries, network requests, background monitoring, or stored chat contents.
EMAIL_RE = re.compile(r"(?i)(?<![\w.+-])[\w.+-]{1,64}@[\w.-]+\.[a-z]{2,24}\b")
PHONE_CANDIDATE_RE = re.compile(r"(?<![\w])\+?\d[\d ()-]{8,24}\d(?!\w)")
COORD_RE = re.compile(r"(?<!\d)(-?\d{1,2}\.\d{4,})\s*[,;]\s*(-?\d{1,3}\.\d{4,})(?!\d)")
ADDRESS_RE = re.compile(
    r"(?iu)\b(?:улица|ул\.|проспект|пр-т|переулок|пер\.|бульвар|шоссе|"
    r"дом\s*№?|квартира|кв\.|подъезд|postcode|street|avenue|road|apt\.?|address)"
    r"\s*[\w.\- ]{0,42}\d[а-яa-z]?\b"
)
# Code must appear close to a login / verification keyword, to avoid blocking all ordinary numbers.
CODE_RE = re.compile(
    r"(?iu)\b(?:код(?:\s+для\s+входа)?|подтверждени\w*|вход|"
    r"одноразов\w*|verification|login|otp|2fa|passcode|telegram\s+code)\b"
    r"[^\n]{0,55}?\b\d(?:[ -]?\d){3,7}\b"
)
URL_RE = re.compile(r"(?i)(?:https?://|www\.)[^\s<>\"'`]+")
DANGEROUS_DOMAINS = {
    "grabify.link", "iplogger.org", "iplogger.ru", "2no.co", "yip.su",
    "blasze.com", "iplogger.com", "iplogger.info", "ezstat.ru",
}
SHORTENERS = {
    "bit.ly", "tinyurl.com", "t.co", "is.gd", "cutt.ly", "rebrand.ly",
    "shorturl.at", "clck.ru", "vk.cc", "goo.su", "surl.li",
}
RISKY_QUERY_KEYS = {
    "access_token", "id_token", "api_key", "apikey", "session", "sessionid",
    "password", "passwd", "secret", "auth_token", "refresh_token",
}
THREAT_RE = re.compile(
    r"(?iu)\b(?:докс(?:инг|ить|ну|нул|анём)?|задокс\w*|пробью|пробив\w*|"
    r"сват(?:ну|нуть|инг|тинг)?|swat(?:ting)?|вычисл\w*|найду\s+твой\s+адрес|"
    r"вызову\s+полицию\s+к\s+тебе)\b"
)
PHISH_RE = re.compile(
    r"(?iu)(?:\b(?:код|otp|2fa|password|пароль|авториз\w*|подтверди\w*|"
    r"верификац\w*)\b.{0,60}\b(?:пришли|скажи|отправь|send|give|share|введи)\b|"
    r"\b(?:пришли|скажи|отправь|send|give|share|введи)\b.{0,60}"
    r"\b(?:код|otp|2fa|password|пароль)\b)"
)
LOCATION_MEDIA = {
    "TL_inputMediaGeoPoint", "TL_inputMediaGeoLive", "TL_inputMediaVenue",
}
CONTACT_MEDIA = {"TL_inputMediaContact"}
OUTGOING_MEDIA_REQUESTS = {"TL_messages_sendMedia", "TL_messages_sendMultiMedia"}
UPDATE_NAMES = {
    "TL_updateNewMessage", "TL_updateNewChannelMessage", "TL_updateShortMessage",
    "TL_updateShortChatMessage",
}


def _java_name(obj: Any) -> str:
    if obj is None:
        return ""
    try:
        return str(obj.getClass().getSimpleName())
    except Exception:
        return type(obj).__name__


def _field(obj: Any, key: str, default: Any = None) -> Any:
    try:
        return getattr(obj, key, default)
    except Exception:
        return default


def _as_text(value: Any) -> str:
    if value is None:
        return ""
    try:
        return str(value)
    except Exception:
        return ""


def _link_risk(raw_url: str) -> Optional[str]:
    try:
        clean = raw_url.rstrip(".,);!?]}")
        parsed = urlsplit(clean if "://" in clean else "https://" + clean)
        host = (parsed.hostname or "").lower().rstrip(".")
        if not host:
            return None
        if any(host == domain or host.endswith("." + domain) for domain in DANGEROUS_DOMAINS):
            return "IP-логгер / трекинговый домен"
        if any(host == domain or host.endswith("." + domain) for domain in SHORTENERS):
            return "сокращённая ссылка с неизвестным адресом"
        if "xn--" in host or any(ord(ch) > 127 for ch in host):
            return "IDN-адрес, который может маскировать другой домен"
        try:
            ipaddress.ip_address(host.strip("[]"))
            return "ссылка на прямой IP-адрес"
        except ValueError:
            pass
        keys = {name.lower() for name, _value in parse_qsl(parsed.query, keep_blank_values=True)}
        if keys.intersection(RISKY_QUERY_KEYS):
            return "в ссылке есть параметр, похожий на секретный токен"
    except Exception:
        pass
    return None


def _sensitive_reason(text: str, *, include_link: bool = True, include_code: bool = True) -> Optional[str]:
    if not text:
        return None
    if include_code and CODE_RE.search(text):
        return "похожий на код входа или подтверждения фрагмент"
    if EMAIL_RE.search(text):
        return "адрес электронной почты"
    for candidate in PHONE_CANDIDATE_RE.finditer(text):
        digits = re.sub(r"\D", "", candidate.group(0))
        if 10 <= len(digits) <= 15:
            return "похожий на номер телефона фрагмент"
    match = COORD_RE.search(text)
    if match:
        lat, lon = float(match.group(1)), float(match.group(2))
        if -90 <= lat <= 90 and -180 <= lon <= 180:
            return "географические координаты"
    if ADDRESS_RE.search(text):
        return "возможный домашний адрес"
    if include_link:
        for url in URL_RE.findall(text):
            reason = _link_risk(url)
            if reason:
                return reason
    return None


def _incoming_reason(text: str) -> Optional[str]:
    if not text:
        return None
    if THREAT_RE.search(text):
        return "в сообщении возможная угроза доксинга или ложного вызова служб"
    if PHISH_RE.search(text):
        return "в сообщении могут выманивать код или пароль"
    for url in URL_RE.findall(text):
        reason = _link_risk(url)
        if reason:
            return reason
    return None


def _media_type(request: Any):
    """Return (media_name, inspection_complete). Never read media bytes."""
    request_name = _java_name(request)
    if request_name == "TL_messages_sendMedia":
        media = _field(request, "media")
        return [_java_name(media)], media is not None
    if request_name == "TL_messages_sendMultiMedia":
        items = _field(request, "multi_media")
        if items is None:
            return [], False
        try:
            result = []
            for item in items:
                media = _field(item, "media")
                if media is None:
                    return result, False
                result.append(_java_name(media))
            return result, bool(result)
        except Exception:
            return [], False
    return [], True


class PrivacyShieldPlugin(BasePlugin):
    def on_plugin_load(self):
        self._last_incoming_warning = {}
        self.add_on_send_message_hook(priority=100)
        for name in (
            "TL_messages_setTyping", "TL_messages_setEncryptedTyping",
            "TL_account_updateStatus", "TL_contacts_importContacts",
            "TL_messages_getWebPagePreview", "TL_messages_forwardMessages",
            "TL_messages_sendMessage", "TL_messages_sendMedia", "TL_messages_sendMultiMedia",
            *sorted(UPDATE_NAMES),
        ):
            self.add_hook(name, priority=100)
        self.logger.info("Privacy Shield enabled; local rules, no network calls.")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="🛡 Защита исходящих данных"),
            Switch(key="block_pii", text="Блокировать личные данные", default=True,
                   subtext="Телефон, e-mail, адрес, координаты; возможны ложные срабатывания."),
            Switch(key="block_codes", text="Блокировать коды входа", default=True,
                   subtext="Когда код сопровождается словами о входе или подтверждении."),
            Switch(key="block_links", text="Блокировать рискованные ссылки", default=True,
                   subtext="IP-логгеры, сокращатели, IDN и ссылки с токенами."),
            Switch(key="block_location", text="Запретить отправку геолокации", default=True,
                   subtext="Включая Live Location и точки на карте в обычных чатах."),
            Switch(key="block_contacts", text="Запретить отправку карточек контактов", default=True),
            Switch(key="block_media", text="Параноидальный режим: запретить медиа", default=True,
                   subtext="Фото, документы, видео и другое медиа в обычных чатах. Отключите, если нужно отправлять файлы."),
            Switch(key="block_forwards", text="Запретить пересылку сообщений", default=True),
            Header(text="👻 Сокращение цифрового следа"),
            Switch(key="disable_typing", text="Не отправлять статус набора", default=True),
            Switch(key="force_offline", text="Запрашивать статус офлайн", default=True,
                   subtext="Не гарантирует полной невидимости: видимость зависит от Telegram."),
            Switch(key="block_contact_sync", text="Блокировать новую синхронизацию контактов", default=True,
                   subtext="Ранее загруженные контакты нужно удалить в настройках Telegram."),
            Switch(key="block_previews", text="Отключать запросы предпросмотра ссылок", default=True),
            Header(text="🚨 Предупреждения"),
            Switch(key="incoming_alerts", text="Предупреждать о подозрительных сообщениях", default=True,
                   subtext="Фишинг, IP-логгеры, признаки угроз. Не блокирует открытие ссылок."),
            Text(text="Важно: плагин не скрывает IP во всех случаях, Telegram ID, старые утечки, номер у знакомых или общие группы."),
            Text(text="Проверьте вручную: номер телефона, поиск по номеру, переадресации, звонки P2P, фото профиля, группы, активные сеансы и двухэтапную проверку."),
        ]

    def _enabled(self, key: str, default: bool = True) -> bool:
        return bool(self.get_setting(key, default))

    def _active_account(self, account: int) -> bool:
        try:
            from org.telegram.messenger import UserConfig
            return int(UserConfig.selectedAccount) == int(account)
        except Exception:
            # Never show details of a background account in the current account's UI.
            return False

    def _notify(self, account: int, message: str, *, incoming: bool = False):
        if not self._active_account(account):
            return
        try:
            if incoming:
                BulletinHelper.show_info(message)
            else:
                BulletinHelper.show_error(message)
        except Exception:
            self.logger.warning("Could not display safety bulletin")

    def _cancel(self, account: int, reason: str) -> HookResult:
        # Never log or display the sensitive contents themselves.
        self._notify(account, "Privacy Shield заблокировал отправку: " + reason)
        return HookResult(strategy=HookStrategy.CANCEL)

    def _text_violation(self, text: str) -> Optional[str]:
        if not text:
            return None
        if self._enabled("block_codes") and CODE_RE.search(text):
            return "возможный код входа"
        if self._enabled("block_pii"):
            reason = _sensitive_reason(text, include_link=False, include_code=False)
            if reason:
                return reason
        if self._enabled("block_links"):
            for url in URL_RE.findall(text):
                reason = _link_risk(url)
                if reason:
                    return reason
        return None

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        message = _field(params, "message")
        if message is not None:
            reason = self._text_violation(_as_text(message))
            if reason:
                return self._cancel(account, reason)
        return HookResult()

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if request_name in ("TL_messages_setTyping", "TL_messages_setEncryptedTyping"):
            if self._enabled("disable_typing"):
                return HookResult(strategy=HookStrategy.CANCEL)
        if request_name == "TL_account_updateStatus" and self._enabled("force_offline"):
            try:
                request.offline = True
                return HookResult(strategy=HookStrategy.MODIFY, request=request)
            except Exception:
                return HookResult()
        if request_name == "TL_contacts_importContacts" and self._enabled("block_contact_sync"):
            return HookResult(strategy=HookStrategy.CANCEL)
        if request_name == "TL_messages_getWebPagePreview" and self._enabled("block_previews"):
            return HookResult(strategy=HookStrategy.CANCEL)
        if request_name == "TL_messages_forwardMessages" and self._enabled("block_forwards"):
            return self._cancel(account, "пересылка сообщений запрещена")
        if request_name in ("TL_messages_sendMessage", "TL_messages_sendMedia"):
            # Defense-in-depth for messages sent by paths that bypass the SendMessageParams hook.
            reason = self._text_violation(_as_text(_field(request, "message")))
            if reason:
                return self._cancel(account, reason)
        if request_name in OUTGOING_MEDIA_REQUESTS:
            media_names, complete = _media_type(request)
            if self._enabled("block_media"):
                return self._cancel(account, "включён запрет на медиа")
            if not complete:
                # Can't reliably inspect unknown media, so don't falsely claim to block them.
                return HookResult()
            if self._enabled("block_location") and any(n in LOCATION_MEDIA for n in media_names):
                return self._cancel(account, "геолокация")
            if self._enabled("block_contacts") and any(n in CONTACT_MEDIA for n in media_names):
                return self._cancel(account, "карточка контакта")
        return HookResult()

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        if update_name not in UPDATE_NAMES or not self._enabled("incoming_alerts"):
            return HookResult()
        obj = _field(update, "message")
        if _field(obj, "out", False):
            return HookResult()
        text = _as_text(_field(obj, "message")) if obj is not None else ""
        # Short updates expose the text directly on update.message.
        if not text and update_name.startswith("TL_updateShort"):
            text = _as_text(obj)
        reason = _incoming_reason(text)
        if not reason:
            return HookResult()
        now = time.monotonic()
        last = self._last_incoming_warning.get(account, 0.0)
        if now - last >= 10.0:
            self._last_incoming_warning[account] = now
            self._notify(account, "Privacy Shield: " + reason, incoming=True)
        return HookResult()
